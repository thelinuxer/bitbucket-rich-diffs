{
  "manifest_version": 3,
  "name": "Bitbucket Markdown Diff Renderer",
  "version": "0.1.6",
  "description": "Renders Markdown files in Bitbucket Cloud pull-request diffs as unified or side-by-side rendered views.",
  "minimum_chrome_version": "108",
  "host_permissions": [
    "*://bitbucket.org/*",
    "*://api.bitbucket.org/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://bitbucket.org/*/pull-requests/*"],
      "js": [
        "lib/marked.min.js",
        "lib/diff.min.js",
        "lib/purify.min.js",
        "src/renderer.js",
        "src/content.js"
      ],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
